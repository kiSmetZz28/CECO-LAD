# Editor / tool local config
.vscode/
.claude/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.env/
.conda/

# Jupyter
.ipynb_checkpoints/

# Build artifacts
*.egg-info/
dist/
build/
.eggs/

# Tests and test artifacts
tests/
.pytest_cache/
.coverage
htmlcov/

# Logs (auto-generated by setup_logging)
*.log
logs/
# Exception: bundled OpenStack raw log samples (small, needed by dashboard)
!data/OpenStack/raw/*.log

# Runtime outputs (checkpoints and outputs are deployment artifacts)
checkpoints/
outputs/

# SQLite database (rebuilt at runtime, too large for GitHub)
*.db

# ExecuTorch source + build tree (~1.4 GB, downloaded via tools/download_data.py)
inference_pipeline/executorch/
inference_pipeline/executorch.zip
